# AITenderIndonesia.com - Environment Variables
# Copy to .env and fill values

PORT=3000

# === GitHub (data layer) ===
# Personal Access Token with repo write access
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Repo path - format MUST be "owner/repo" (NOT just "repo")
GITHUB_REPO=emerilansel-jpg/tenderstore-chatbot-demo

# === LLM Providers ===
# Primary: Google Gemini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback x4: OpenRouter free tier
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Optional ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxx
